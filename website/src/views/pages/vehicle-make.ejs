<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/vehicles">Vehicles</a></li>
    <li class="breadcrumb-item active"><%= make %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center">
  <h1><%= make %></h1>
  <button type="button" class="btn btn-outline-danger btn-sm"
    data-delete-url="/vehicles/<%= encodeURIComponent(make) %>"
    data-delete-name="<%= make %> (and all its models, years, and vehicles)"
    data-delete-context="page"
    data-delete-redirect="/vehicles"
  >
    <i class="bi bi-trash"></i> Delete <%= make %>
  </button>
</div>

<div class="mb-3">
  <%- include('../partials/star-rating', { metaUrl: `/vehicles/${encodeURIComponent(make)}/meta`, rating: meta.rating, status: meta.status, large: true }) %>
</div>

<h2 class="h5 mt-4">Models</h2>
<% if (models.length === 0) { %>
  <p class="text-muted">None researched yet.</p>
<% } else { %>
  <div class="mb-3">
    <label for="modelSearch" class="visually-hidden">Search models</label>
    <input type="search" id="modelSearch" class="form-control" placeholder="Search models…">
  </div>

  <div class="table-responsive">
    <table class="table table-hover table-bordered align-middle" id="modelsTable">
      <thead>
        <tr>
          <th scope="col" style="width: 100%;" data-sort="name" data-type="string" role="button">Model <i class="bi sort-icon"></i></th>
          <th scope="col" class="text-nowrap" data-sort="rating" data-type="number" role="button">Rating <i class="bi sort-icon"></i></th>
          <th scope="col" class="visually-hidden text-nowrap">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% models.forEach((model) => {
          const modelUrl = `/vehicles/${encodeURIComponent(make)}/${encodeURIComponent(model.model)}`;
        %>
          <tr
            data-name="<%= model.model.toLowerCase() %>"
            data-rating="<%= model.meta.rating %>"
            data-search="<%= model.model.toLowerCase() %>"
            class="tree-row"
            style="cursor: pointer;"
            data-href="<%= modelUrl %>"
          >
            <td><a href="<%= modelUrl %>" class="fw-semibold text-decoration-none"><%= model.model %></a></td>
            <td>
              <%- include('../partials/star-rating', { metaUrl: `${modelUrl}/meta`, rating: model.meta.rating, status: model.meta.status }) %>
            </td>
            <td>
              <button type="button" class="btn btn-sm btn-outline-danger row-delete"
                data-delete-url="<%= modelUrl %>"
                data-delete-name="<%= make %> <%= model.model %> (and all its years and vehicles)"
                data-delete-context="page"
                data-delete-redirect="/vehicles/<%= encodeURIComponent(make) %>"
                title="Delete <%= model.model %> and everything under it"
              >
                <i class="bi bi-trash"></i>
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <p class="text-muted small" id="modelEmptyState" style="display: none;">No models match your search.</p>
<% } %>

<h2 class="h5 mt-4">Vehicles</h2>
<% if (vins.length === 0) { %>
  <p class="text-muted">None researched yet.</p>
<% } else { %>
  <div class="mb-3">
    <label for="makeVinSearch" class="visually-hidden">Search vehicles</label>
    <input type="search" id="makeVinSearch" class="form-control" placeholder="Search vehicles…">
  </div>

  <div class="table-responsive">
    <table class="table table-hover table-bordered align-middle" id="makeVinsTable">
      <thead>
        <tr>
          <th scope="col" data-sort="model" data-type="string" role="button">Model <i class="bi sort-icon"></i></th>
          <th scope="col" data-sort="year" data-type="string" role="button">Year <i class="bi sort-icon"></i></th>
          <th scope="col" data-sort="vin" data-type="string" role="button">VIN <i class="bi sort-icon"></i></th>
          <th scope="col" data-sort="rating" data-type="number" role="button">Rating <i class="bi sort-icon"></i></th>
          <th scope="col" style="width: 100%;">Seller</th>
          <th scope="col" class="visually-hidden text-nowrap">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% vins.forEach((v) => {
          const vehicleUrl = `/vehicles/${encodeURIComponent(make)}/${encodeURIComponent(v.model)}/${encodeURIComponent(v.year)}/${encodeURIComponent(v.vin)}`;
          const searchBlob = [v.model, v.year, v.vin, v.seller.name, v.bottomLine].join(' ').toLowerCase();
        %>
          <tr
            data-model="<%= v.model.toLowerCase() %>"
            data-year="<%= v.year.toLowerCase() %>"
            data-vin="<%= v.vin.toLowerCase() %>"
            data-rating="<%= v.meta.rating %>"
            data-search="<%= searchBlob %>"
            class="tree-row"
            style="cursor: pointer;"
            data-href="<%= vehicleUrl %>"
          >
            <td><a href="/vehicles/<%= encodeURIComponent(make) %>/<%= encodeURIComponent(v.model) %>" class="text-decoration-none"><%= v.model %></a></td>
            <td><a href="/vehicles/<%= encodeURIComponent(make) %>/<%= encodeURIComponent(v.model) %>/<%= encodeURIComponent(v.year) %>" class="text-decoration-none"><%= v.year %></a></td>
            <td><a href="<%= vehicleUrl %>" class="fw-semibold text-decoration-none"><%= v.vin %></a></td>
            <td>
              <%- include('../partials/star-rating', { metaUrl: `${vehicleUrl}/meta`, rating: v.meta.rating, status: v.meta.status, aiRating: v.aiRating, bottomLineHtml: v.bottomLineHtml }) %>
            </td>
            <td>
              <% if (v.seller.url) { %>
                <a href="<%= v.seller.url %>" target="_blank" rel="noopener noreferrer"><%= v.seller.name %> <i class="bi bi-box-arrow-up-right"></i></a>
              <% } else { %>
                <%= v.seller.name %>
              <% } %>
            </td>
            <td>
              <button type="button" class="btn btn-sm btn-outline-danger row-delete"
                data-delete-url="<%= vehicleUrl %>"
                data-delete-name="<%= v.vin %>"
                data-delete-context="row"
                data-delete-row-selector="tr"
                title="Delete this vehicle"
              >
                <i class="bi bi-trash"></i>
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <p class="text-muted small" id="makeVinEmptyState" style="display: none;">No vehicles match your search.</p>
<% } %>

<script src="/js/simple-tree-table.js" data-table-id="modelsTable" data-search-id="modelSearch" data-empty-id="modelEmptyState"></script>
<script src="/js/simple-tree-table.js" data-table-id="makeVinsTable" data-search-id="makeVinSearch" data-empty-id="makeVinEmptyState"></script>
<script src="/js/rating.js"></script>
<script src="/js/popovers.js"></script>
