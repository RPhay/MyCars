<h1 class="mb-4">MyCars</h1>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <a href="/dealerships" class="text-decoration-none">
      <div class="card h-100">
        <div class="card-body text-center">
          <div class="display-6"><%= counts.dealershipCount %></div>
          <div class="text-muted">Dealerships researched</div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/vehicles" class="text-decoration-none">
      <div class="card h-100">
        <div class="card-body text-center">
          <div class="display-6"><%= counts.vinCount %></div>
          <div class="text-muted">Specific vehicles researched</div>
        </div>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/vehicles" class="text-decoration-none">
      <div class="card h-100">
        <div class="card-body text-center">
          <div class="display-6"><%= counts.overviewCount %></div>
          <div class="text-muted">Vehicle types researched</div>
        </div>
      </div>
    </a>
  </div>
</div>

<% if (counts.dealershipCount === 0 && counts.vinCount === 0 && counts.overviewCount === 0) { %>
  <div class="alert alert-info">
    <strong>No research yet.</strong> Use the buttons below, or the ones on the Dealerships/Vehicles pages, to analyze a vehicle or a dealership — results show up here and under <code>dealerships/</code> / <code>vehicles/</code>.
  </div>
<% } %>

<div class="d-flex gap-2">
  <button type="button" class="btn btn-primary" data-research="vehicle"><i class="bi bi-car-front"></i> Research a vehicle</button>
  <button type="button" class="btn btn-primary" data-research="skill" data-skill="dealership-analyzer"><i class="bi bi-shop"></i> Analyze a dealership</button>
  <a href="/dealerships" class="btn btn-outline-secondary">Browse dealerships</a>
  <a href="/vehicles" class="btn btn-outline-secondary">Browse vehicles</a>
</div>
