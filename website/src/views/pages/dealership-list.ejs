<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Dealerships</h1>
  <button type="button" class="btn btn-primary btn-sm" data-research="skill" data-skill="dealership-analyzer">
    <i class="bi bi-plus-lg"></i> Analyze a dealership
  </button>
</div>

<% if (dealerships.length === 0) { %>
  <div class="alert alert-info">No dealerships researched yet.</div>
<% } else { %>
  <div class="list-group">
    <% dealerships.forEach(d => { %>
      <a href="/dealerships/<%= encodeURIComponent(d.domain) %>" class="list-group-item list-group-item-action">
        <div class="d-flex w-100 justify-content-between">
          <h5 class="mb-1"><%= d.title %></h5>
          <small class="text-muted"><%= d.fields['Last updated'] || '' %></small>
        </div>
        <p class="mb-1 text-truncate"><%= d.bottomLine %></p>
        <small class="text-muted"><%= d.domain %></small>
      </a>
    <% }) %>
  </div>
<% } %>
