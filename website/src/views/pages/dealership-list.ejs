<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Dealerships</h1>
  <div class="d-flex gap-2">
    <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addDealershipModal">
      <i class="bi bi-plus-lg"></i> Add a dealership
    </button>
    <button type="button" class="btn btn-primary btn-sm" data-research="skill" data-skill="dealership-analyzer">
      <i class="bi bi-plus-lg"></i> Analyze a dealership
    </button>
  </div>
</div>

<div class="modal fade" id="addDealershipModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="addDealershipForm">
        <div class="modal-header border-0">
          <h5 class="modal-title">Add a dealership</h5>
        </div>
        <div class="modal-body">
          <p class="text-muted small">Adds it to the list without researching it yet — use "Research" on its row whenever you're ready.</p>
          <div class="mb-2">
            <label class="form-label small mb-0">Name</label>
            <input type="text" name="name" class="form-control form-control-sm" required>
          </div>
          <div class="mb-2">
            <label class="form-label small mb-0">Site URL</label>
            <input type="url" name="url" class="form-control form-control-sm" placeholder="https://..." required>
          </div>
          <p class="text-danger small mb-0" id="addDealershipError" style="display: none;"></p>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Add</button>
        </div>
      </form>
    </div>
  </div>
</div>

<% if (dealerships.length === 0) { %>
  <div class="alert alert-info">No dealerships researched yet.</div>
<% } else { %>
  <div class="mb-3">
    <label for="dealershipSearch" class="visually-hidden">Search dealerships</label>
    <input type="search" id="dealershipSearch" class="form-control" placeholder="Search dealerships…">
  </div>

  <div class="table-responsive">
    <table class="table table-hover table-bordered align-middle" id="dealershipTable">
      <thead>
        <tr>
          <th scope="col" data-sort="name" data-type="string" role="button">Name <i class="bi sort-icon"></i></th>
          <th scope="col" data-sort="rating" data-type="number" role="button">Rating <i class="bi sort-icon"></i></th>
          <th scope="col" data-sort="location" data-type="string" role="button">Location <i class="bi sort-icon"></i></th>
          <th scope="col" data-sort="updated" data-type="string" role="button">Last updated <i class="bi sort-icon"></i></th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% dealerships.forEach(d => {
          const location = d.fields['Address'] || '';
          const updated = d.fields['Last updated'] || '';
          const site = d.fields['Site'] || '';
          const searchBlob = [d.title, location, d.bottomLine, d.domain].join(' ').toLowerCase();
        %>
          <tr
            data-name="<%= d.title.toLowerCase() %>"
            data-location="<%= location.toLowerCase() %>"
            data-updated="<%= updated %>"
            data-rating="<%= d.meta.rating %>"
            data-search="<%= searchBlob %>"
            class="dealership-row"
            style="cursor: pointer;"
            data-href="/dealerships/<%= encodeURIComponent(d.domain) %>"
          >
            <td>
              <a href="/dealerships/<%= encodeURIComponent(d.domain) %>" class="fw-semibold text-decoration-none"><%= d.title %></a>
              <% if (site) { %>
                <a href="<%= site %>" target="_blank" rel="noopener noreferrer" title="<%= site %>" class="ms-1">
                  <i class="bi bi-box-arrow-up-right"></i>
                </a>
              <% } %>
            </td>
            <td>
              <%- include('../partials/star-rating', {
                metaUrl: `/dealerships/${encodeURIComponent(d.domain)}/meta`,
                rating: d.meta.rating,
                status: d.meta.status,
                aiRating: d.aiRating,
                bottomLineHtml: d.bottomLineHtml,
              }) %>
            </td>
            <td><%= location %></td>
            <td><%= updated %></td>
            <td>
              <button type="button" class="btn btn-sm btn-outline-primary"
                data-research="skill" data-skill="dealership-analyzer" data-url="<%= site %>"
                title="<%= d.aiRating != null ? 'Re-research' : 'Research' %> <%= d.title %>"
              >
                <i class="bi bi-arrow-repeat"></i>
              </button>
              <button type="button" class="btn btn-sm btn-outline-danger"
                data-delete-url="/dealerships/<%= encodeURIComponent(d.domain) %>"
                data-delete-name="<%= d.title %>"
                data-delete-context="row"
                data-delete-row-selector="tr"
                title="Delete <%= d.title %>"
              >
                <i class="bi bi-trash"></i>
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <p class="text-muted small" id="dealershipEmptyState" style="display: none;">No dealerships match your search.</p>
  <script src="/js/dealership-table.js"></script>
  <script src="/js/rating.js"></script>
  <script src="/js/popovers.js"></script>
<% } %>

<script src="/js/add-dealership.js"></script>
