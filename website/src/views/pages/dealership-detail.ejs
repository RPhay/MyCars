<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/dealerships">Dealerships</a></li>
    <li class="breadcrumb-item active"><%= dealership.title %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center">
  <h1><%= dealership.title %></h1>
  <button type="button" class="btn btn-outline-primary btn-sm" data-research="skill" data-skill="dealership-analyzer" data-url="<%= dealership.fields['Site'] %>">
    <i class="bi bi-arrow-repeat"></i> Re-analyze
  </button>
</div>

<dl class="row">
  <% Object.entries(dealership.fieldsHtml).forEach(([key, html]) => { %>
    <dt class="col-sm-2"><%= key %></dt>
    <dd class="col-sm-10"><%- html %></dd>
  <% }) %>
</dl>

<hr>

<div class="research-body">
  <%- dealership.bodyHtml %>
</div>
